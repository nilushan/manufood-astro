---
import siteData from '../content/site.json';
---

<footer class="footer footer-center bg-primary text-primary-content p-10">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full max-w-6xl">
    <div>
      <h3 class="footer-title">About {siteData.name}</h3>
      <p class="opacity-90">{siteData.footer.about}</p>
    </div>
    
    <div>
      <h3 class="footer-title">Quick Links</h3>
      <nav class="grid grid-flow-col gap-4">
        {siteData.navigation.map((item) => (
          <a href={item.href} class="link link-hover">{item.name}</a>
        ))}
      </nav>
    </div>
    
    <div>
      <h3 class="footer-title">Contact Us</h3>
      <div class="grid gap-2">
        <p class="flex items-center gap-2">
          <span>📞</span>
          Juliya: {siteData.contact.phone}
        </p>
        <p class="flex items-center gap-2">
          <span>📍</span>
          {siteData.contact.location}
        </p>
        <p class="flex items-center gap-2">
          <span>🕒</span>
          {siteData.contact.pickupTime}
        </p>
      </div>
    </div>
  </div>
  
  <div class="divider"></div>
  
  <div>
    <p class="opacity-80">{siteData.footer.copyright}</p>
  </div>
</footer>
