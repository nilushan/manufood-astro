---
import { Image } from 'astro:assets';
import siteData from '../content/site.json';
import { images } from '../lib/images';
---

<div class="hero bg-gradient-to-br from-primary to-base-300 text-base-content min-h-screen pt-16">
  <div class="hero-content text-center">
    <div class="max-w-4xl">
      <h1 class="text-5xl font-bold mb-5">{siteData.name}</h1>
      <p class="text-xl mb-8 opacity-90">{siteData.tagline}</p>
      
      <div class="hero-image-container mb-8">
        <Image 
          src={images['hero-food']}
          alt="Authentic Sri Lankan food spread with rice, curries, and side dishes"
          class="rounded-lg shadow-2xl"
          width={1800}
          height={1600}
          format="webp"
          quality={90}
          loading="eager"
        />
      </div>
      
      <div class="text-lg text-center opacity-80 max-w-4xl">{siteData.description}</div>
    </div>
  </div>
</div>

