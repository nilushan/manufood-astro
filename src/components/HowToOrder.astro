---
import siteData from '../content/site.json';
---

<section class="py-16 bg-base-100">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-4 text-base-content">How to Order</h2>
    <div class="w-16 h-1 bg-error mx-auto mb-12"></div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
      {siteData.howToOrder.map((step) => (
        <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-all duration-300">
          <div class="card-body text-center">
            <div class="badge badge-success badge-lg w-12 h-12 text-xl font-bold mx-auto mb-4">
              {step.step}
            </div>
            <h3 class="card-title justify-center text-lg mb-3">{step.title}</h3>
            <p class="text-base-content/70 text-sm mb-3">{step.description}</p>
            {step.details && (
              <div class="badge badge-primary badge-outline badge-sm">
                {step.details}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
