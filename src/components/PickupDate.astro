---
import menuData from '../content/menu.json';
---

<section class="py-16 bg-gradient-to-br from-warning/20 to-accent/20">
  <div class="container mx-auto px-4">
    <div class="card bg-base-100 shadow-2xl max-w-2xl mx-auto">
      <div class="card-body text-center">
        <h2 class="card-title justify-center text-3xl mb-6">Next Pickup Date</h2>
        
        <div class="flex flex-col lg:flex-row items-center gap-6">
          <div class="badge badge-primary badge-lg p-6 text-2xl font-bold">
            <div class="text-center">
              <div class="text-3xl">{menuData.nextPickupDate.date}</div>
              <div class="text-sm opacity-80">{menuData.nextPickupDate.month}</div>
            </div>
          </div>
          
          <div class="flex-1 space-y-2">
            <div class="flex justify-between items-center py-2 border-b border-base-300">
              <span class="font-semibold text-success">Location:</span>
              <span class="text-base-content">{menuData.nextPickupDate.location}</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-base-300">
              <span class="font-semibold text-success">Order Before:</span>
              <span class="text-base-content">{menuData.nextPickupDate.orderBefore}</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="font-semibold text-success">Pickup Time:</span>
              <span class="text-base-content">{menuData.nextPickupDate.pickupTime}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
