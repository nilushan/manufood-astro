---
import { Image } from 'astro:assets';
import galleryData from '../content/gallery.json';
import { images } from '../lib/images';
---

<section class="py-16 bg-base-100">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-4 text-base-content">Latest From Our Kitchen</h2>
    <div class="w-16 h-1 bg-error mx-auto mb-12"></div>
    
    {galleryData.galleries.map((gallery) => (
      <div class="card bg-base-200 shadow-xl mb-8 hover:shadow-2xl transition-all duration-300">
        <div class="card-body">
          <div class="flex justify-between items-center mb-6">
            <h3 class="card-title text-2xl">Dishes on {gallery.date}</h3>
            <a 
              href={`/gallery/${gallery.date.toLowerCase().replace(/\s+/g, '-').replace(/,/g, '')}`}
              class="btn btn-outline btn-primary btn-sm"
            >
              View Full Collection
            </a>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {gallery.dishes.map((dish) => (
              <div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <figure class="h-48">
                  <Image 
                    src={images[dish.image]} 
                    alt={dish.name}
                    class="w-full h-full object-cover"
                    width={300}
                    height={200}
                    format="webp"
                    quality={85}
                    loading="lazy"
                  />
                </figure>
                <div class="card-body p-4">
                  <h4 class="card-title text-lg">{dish.name}</h4>
                  <p class="text-base-content/70 text-sm line-clamp-3">{dish.description}</p>
                  <div class="card-actions justify-end mt-3">
                    <div class="badge badge-primary badge-outline">Sri Lankan</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
