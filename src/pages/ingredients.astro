---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Ingredients - MaNu Foods">
  <Header />
  
  <main id="main-content" class="ingredients-page">
    <div class="container mx-auto px-4">
      <div class="page-header">
        <h1 class="page-title">Our Ingredients</h1>
        <p class="page-subtitle">Fresh, authentic Sri Lankan ingredients</p>
      </div>
      
      <div class="ingredients-content">
        <div class="ingredients-section">
          <h2 class="section-title">Quality Promise</h2>
          <div class="quality-grid">
            <div class="quality-card">
              <div class="quality-icon">🌿</div>
              <h3>Fresh Spices</h3>
              <p>Authentic Sri Lankan spices sourced directly from local suppliers</p>
            </div>
            <div class="quality-card">
              <div class="quality-icon">🥥</div>
              <h3>Fresh Coconut</h3>
              <p>Fresh coconut milk and grated coconut for traditional flavor</p>
            </div>
            <div class="quality-card">
              <div class="quality-icon">🍖</div>
              <h3>Premium Meat</h3>
              <p>High-quality meats from trusted local butchers</p>
            </div>
            <div class="quality-card">
              <div class="quality-icon">🐟</div>
              <h3>Fresh Seafood</h3>
              <p>Fresh fish and prawns for authentic seafood curries</p>
            </div>
            <div class="quality-card">
              <div class="quality-icon">🌾</div>
              <h3>Premium Rice</h3>
              <p>Basmati and traditional Sri Lankan rice varieties</p>
            </div>
            <div class="quality-card">
              <div class="quality-icon">🥬</div>
              <h3>Fresh Vegetables</h3>
              <p>Locally sourced fresh vegetables and greens</p>
            </div>
          </div>
        </div>
        
        <div class="ingredients-section">
          <h2 class="section-title">Common Ingredients</h2>
          <div class="ingredients-list">
            <div class="ingredient-category">
              <h3>Spices & Seasonings</h3>
              <ul>
                <li>Cinnamon</li>
                <li>Cardamom</li>
                <li>Cloves</li>
                <li>Curry leaves</li>
                <li>Turmeric</li>
                <li>Coriander</li>
                <li>Cumin</li>
                <li>Fenugreek</li>
                <li>Red chili powder</li>
                <li>Black pepper</li>
              </ul>
            </div>
            
            <div class="ingredient-category">
              <h3>Vegetables & Fruits</h3>
              <ul>
                <li>Brinjal (Eggplant)</li>
                <li>Okra</li>
                <li>Banana flower</li>
                <li>Breadfruit</li>
                <li>Snake gourd</li>
                <li>Leeks</li>
                <li>Passion fruit leaves</li>
                <li>Carrots</li>
                <li>Onions</li>
                <li>Garlic</li>
              </ul>
            </div>
            
            <div class="ingredient-category">
              <h3>Proteins</h3>
              <ul>
                <li>Chicken</li>
                <li>Beef</li>
                <li>Pork</li>
                <li>Fish (Marlin, Mackerel)</li>
                <li>Prawns</li>
                <li>Dhal (Lentils)</li>
                <li>Eggs</li>
              </ul>
            </div>
            
            <div class="ingredient-category">
              <h3>Staples</h3>
              <ul>
                <li>Basmati Rice</li>
                <li>Coconut milk</li>
                <li>Coconut oil</li>
                <li>Roti flour</li>
                <li>Rice flour</li>
                <li>Tamarind</li>
                <li>Jaggery</li>
                <li>Mustard seeds</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="ingredients-section">
          <h2 class="section-title">Dietary Information</h2>
          <div class="dietary-info">
            <div class="dietary-card">
              <h3>🌱 Vegetarian Options</h3>
              <p>We offer a variety of vegetarian dishes including dhal curry, vegetable mallums, and coconut-based curries.</p>
            </div>
            <div class="dietary-card">
              <h3>🌶️ Spice Levels</h3>
              <p>Our dishes range from mild to spicy. Please let us know if you have spice preferences when ordering.</p>
            </div>
            <div class="dietary-card">
              <h3>🥥 Coconut Usage</h3>
              <p>Many of our dishes contain coconut milk or grated coconut. Please inform us of any coconut allergies.</p>
            </div>
            <div class="dietary-card">
              <h3>🍃 Fresh Preparation</h3>
              <p>All dishes are prepared fresh on the day of pickup using traditional cooking methods.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>

