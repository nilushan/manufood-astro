---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteData from '../content/site.json';
---

<BaseLayout title="Contact Us - MaNu Foods">
  <Header />
  
  <main id="main-content" class="min-h-screen bg-base-200 pt-16">
    <div class="container mx-auto px-4 py-16">
      <div class="text-center mb-12">
        <h1 class="text-5xl font-bold text-base-content mb-4">Contact Us</h1>
        <p class="text-xl text-base-content/70">Find us in Yarrabilba, QLD</p>
        <div class="w-16 h-1 bg-error mx-auto mt-4"></div>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6">Get in Touch</h2>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="badge badge-primary badge-lg p-4">📞</div>
                <div>
                  <h3 class="font-bold text-lg">Phone</h3>
                  <p class="text-base-content/70">
                    Juliya - <a href="tel:0416019891" class="link link-primary">{siteData.contact.phone}</a>
                  </p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="badge badge-primary badge-lg p-4">📍</div>
                <div>
                  <h3 class="font-bold text-lg">Location</h3>
                  <p class="text-base-content/70">{siteData.contact.location}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6">Hours of Operation</h2>
            <div class="space-y-4">
              <div class="flex justify-between items-center p-4 bg-base-200 rounded-lg">
                <span class="font-semibold">Sunday to Thursday</span>
                <span class="badge badge-success">Accepting orders</span>
              </div>
              <div class="flex justify-between items-center p-4 bg-base-200 rounded-lg">
                <span class="font-semibold">Saturday</span>
                <span class="badge badge-info">3:00 pm to 6:00 pm (Order pickup)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl mb-6">Find Us</h2>
          <div class="hero bg-gradient-to-br from-warning/20 to-accent/20 rounded-lg">
            <div class="hero-content text-center py-12">
              <div class="max-w-md">
                <div class="text-6xl mb-4">📍</div>
                <h3 class="text-2xl font-bold mb-4">Parks Estate, Yarrabilba, QLD</h3>
                <p class="text-base-content/70">
                  Exact pickup location will be provided with your order confirmation
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
