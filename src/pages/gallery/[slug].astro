---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import galleryData from '../../content/gallery.json';
import { images } from '../../lib/images';

export async function getStaticPaths() {
  return galleryData.galleries.map((gallery) => ({
    params: { 
      slug: gallery.date.toLowerCase().replace(/\s+/g, '-').replace(/,/g, '') 
    },
    props: { gallery }
  }));
}

const { gallery } = Astro.props;
---

<BaseLayout title={`${gallery.date} - Gallery - MaNu Foods`}>
  <Header />
  
  <main id="main-content" class="min-h-screen bg-base-200 pt-16">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumbs -->
      <div class="breadcrumbs text-sm mb-8">
        <ul>
          <li><a href="/" class="text-primary hover:text-primary-focus">Home</a></li>
          <li><a href="/gallery" class="text-primary hover:text-primary-focus">Gallery</a></li>
          <li class="text-base-content/70">{gallery.date}</li>
        </ul>
      </div>

      <!-- Collection Header -->
      <div class="hero bg-gradient-to-br from-warning/20 to-accent/20 rounded-lg mb-12">
        <div class="hero-content text-center py-16">
          <div class="max-w-md">
            <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
              Dishes from {gallery.date}
            </h1>
            <p class="text-xl text-base-content/70">
              Authentic Sri Lankan dishes prepared with love
            </p>
          </div>
        </div>
      </div>

      <!-- Image Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {gallery.dishes.map((dish) => (
          <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
            <figure class="h-64">
              <Image 
                src={images[dish.image]} 
                alt={dish.name}
                class="w-full h-full object-cover"
                width={400}
                height={300}
                format="webp"
                quality={90}
                loading="lazy"
              />
            </figure>
            <div class="card-body">
              <h2 class="card-title text-xl">{dish.name}</h2>
              <p class="text-base-content/70">{dish.description}</p>
              <div class="card-actions justify-end mt-4">
                <div class="badge badge-primary badge-outline">Sri Lankan</div>
                <div class="badge badge-secondary badge-outline">Fresh</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation -->
      <div class="card bg-base-100 shadow-lg mb-12">
        <div class="card-body">
          <div class="flex flex-col lg:flex-row justify-between items-center gap-4">
            <a href="/gallery" class="btn btn-outline btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              Back to Gallery
            </a>
            <div class="text-center">
              <p class="text-sm text-base-content/70">Collection</p>
              <p class="font-semibold text-lg">{gallery.date}</p>
            </div>
            <a href="/contact" class="btn btn-primary">
              Order Similar Dishes
            </a>
          </div>
        </div>
      </div>

      <!-- Related Collections -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold text-center mb-8 text-base-content">Other Collections</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {galleryData.galleries.filter(g => g.date !== gallery.date).map((otherGallery) => (
            <a 
              href={`/gallery/${otherGallery.date.toLowerCase().replace(/\s+/g, '-').replace(/,/g, '')}`}
              class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
            >
              <div class="card-body">
                <h3 class="card-title">{otherGallery.date}</h3>
                <p class="text-base-content/70">{otherGallery.dishes.length} delicious dishes</p>
                <div class="card-actions justify-end">
                  <div class="btn btn-primary btn-sm">View Collection</div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
